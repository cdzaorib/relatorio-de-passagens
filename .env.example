# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
# URL do projeto (ex: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (anon / publishable). Pode ir para o browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Resend — usado no envio do e-mail de reset de senha (fase F2)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Remetente verificado no Resend (ex: "Passagens <nao-responda@seudominio.com>")
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# URL pública do app, usada para montar os links dos e-mails.
# Local: http://localhost:3000 | Produção: https://seu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
