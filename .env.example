# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
# URL do projeto (ex: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública. Projeto novo: "publishable key" (sb_publishable_...).
# Projeto antigo: "anon key" (JWT). Serve qualquer uma das duas variáveis.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta ("secret key" sb_secret_... ou a antiga service_role).
# NUNCA vai para o browser nem para o Git: ela ignora a RLS por completo.
# Usada só no servidor, para gerar o link de redefinição de senha.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Resend — envio do e-mail de redefinição de senha
# ---------------------------------------------------------------------------
# Sem RESEND_API_KEY + SUPABASE_SERVICE_ROLE_KEY, o app cai no e-mail padrão
# do próprio Supabase (funciona, mas com o remetente e o texto deles).
RESEND_API_KEY=
# Remetente verificado no Resend (ex: "Passagens <nao-responda@seudominio.com>")
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# URL pública do app, usada para montar os links dos e-mails.
# Local: http://localhost:3000 | Produção: https://seu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
