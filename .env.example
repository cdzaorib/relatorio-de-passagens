# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
# URL do projeto (ex: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública. Projeto novo: "publishable key" (sb_publishable_...).
# Projeto antigo: "anon key" (JWT). Serve qualquer uma das duas variáveis.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# O app não usa chave secreta. O envio de e-mail é do próprio Supabase
# (Authentication > SMTP Settings), então a chave que ignora a RLS não
# precisa existir em produção — e o que não existe não vaza.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# URL pública do app, usada para montar os links dos e-mails.
# Local: http://localhost:3000 | Produção: https://seu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
